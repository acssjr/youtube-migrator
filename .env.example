# Application Configurations
APP_NAME="YouTube Migrator"
DEBUG=true
PORT=8000
HOST="127.0.0.1"

# Database Configuration
DATABASE_URL="sqlite:///database/youtube_migrator.db"

# Storage Directories (absolute or relative to project root)
DOWNLOADS_DIR="downloads"
TOKENS_DIR="tokens"
LOGS_DIR="logs"

# OAuth 2.0 Credentials (From Google Cloud Console)
# Client ID and Secret can be directly set here, or point to a client_secret.json file
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8000/api/auth/callback"
GOOGLE_CLIENT_SECRETS_FILE="client_secret.json"

# Downloads: local backend runs the queue when DOWNLOAD_WORKER_URL is empty.
# On Vercel, an empty URL sends selections to the local companion.
# Optionally configure an HTTPS worker built with Dockerfile.worker.
DOWNLOAD_WORKER_URL=""
DOWNLOAD_WORKER_TOKEN=""
# On the worker only: its own externally accessible HTTPS origin, no trailing /api.
DOWNLOAD_PUBLIC_URL=""
DOWNLOAD_AUTO_UPDATE=true
DOWNLOAD_UPDATE_HOURS=24
# stable or nightly; nightly tracks current YouTube extractor fixes.
DOWNLOAD_UPDATE_CHANNEL="nightly"
DOWNLOAD_RETENTION_HOURS=24
DOWNLOAD_MAX_BYTES=2147483648
DOWNLOAD_TIMEOUT_SECONDS=3600
# Optional Netscape cookies file mounted privately on the worker, never sent by the browser.
DOWNLOAD_COOKIES_FILE=""
