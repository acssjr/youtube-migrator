# Dedicated API for Vercel: run one process with a persistent /app/downloads and /app/database.
FROM node:22-bookworm-slim AS javascript
FROM python:3.12-slim-bookworm
COPY --from=javascript /usr/local/bin/node /usr/local/bin/node
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY backend/requirements.txt ./backend/requirements.txt
RUN pip install --no-cache-dir -r backend/requirements.txt
COPY backend/app ./backend/app
RUN mkdir -p downloads database
ENV PYTHONUNBUFFERED=1 DEBUG=false PORT=8000
EXPOSE 8000
WORKDIR /app/backend
CMD uvicorn app.download_worker:app --host 0.0.0.0 --port ${PORT} --workers 1
